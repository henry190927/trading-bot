# Secrets — never commit
.env
.env.local
.env.*.local

# Optional local Makefile overrides (set ORACLE_HOST, ORACLE_KEY, etc. here
# instead of in your shell rc). Loaded automatically if it exists.
Makefile.local

# Personal feature roadmap — scratchpad, not for distribution.
ROADMAP.md

# User trade journal — personal data, lives on the VPS
journal.csv

# Build artifacts
/tmp/
*.exe
*.test
*.out
trading-serve
trading-analyze
trading-validate
trading-backtest
trading-price
trading-journal
trading-web

# Bare `go build ./cmd/<name>` (without -o) drops the binary into cwd named
# after the package. Guard against accidents.
/serve
/analyze
/validate
/backtest
/price
/journal
/web
/monitor
/mcp
# A/B harness binaries (go build ./cmd/{rangebt,sweepbt,breakbt,snrbt} at root)
/rangebt
/sweepbt
/breakbt
/snrbt
# scratch
/s7.html
/refs/

# But `journal/`, `backtest/`, and similar names are also Go package
# directories at root (journal/journal.go, backtest/backtest.go). Re-
# include those so the build-artifact rule above doesn't silently
# swallow new package files.
!/journal/
!/backtest/

# Python helper scripts under scripts/ leave bytecode caches behind; a bare
# `git add .` would otherwise sweep them in.
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Go
vendor/
go.work
go.work.sum
/openbt
/basebt
/flipbt
/wsprobe
/acct
/protect
# ...but NOT the package of the same name. The entries above exist for the
# BINARIES `go build` drops at the repo root, and a bare `/protect` pattern
# matches a DIRECTORY too — which silently excluded the whole protect/ package
# on 2026-09-05. Caught before committing; it would have built fine locally
# (deploy uploads a binary) and broken every fresh clone.
!/protect/
/shadowbt
/confirmbt
/breakbt
