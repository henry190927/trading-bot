# Secrets — never commit
.env
.env.local
.env.*.local

# Optional local Makefile overrides (set ORACLE_HOST, ORACLE_KEY, etc. here
# instead of in your shell rc). Loaded automatically if it exists.
Makefile.local

# User trade journal — personal data, lives on the VPS
journal.csv

# Build artifacts
/tmp/
*.exe
*.test
*.out
trading-serve
trading-analyze
trading-validate
trading-backtest
trading-price
trading-journal
trading-web

# Bare `go build ./cmd/<name>` (without -o) drops the binary into cwd named
# after the package. Guard against accidents.
/serve
/analyze
/validate
/backtest
/price
/journal
/web
/monitor

# But `journal/`, `backtest/`, and similar names are also Go package
# directories at root (journal/journal.go, backtest/backtest.go). Re-
# include those so the build-artifact rule above doesn't silently
# swallow new package files.
!/journal/
!/backtest/

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Go
vendor/
go.work
go.work.sum
