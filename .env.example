# Copy to trading/.env and fill in your values. Never commit the real .env.
#
# BingX REST API (optional for public endpoints — klines, depth, funding, OI
# all work unauthenticated). Required only when you add signed endpoints.
BINGX_API_KEY=
BINGX_API_SECRET=

# ntfy push notifications — free, no account, topic-based.
# Pick a hard-to-guess topic (anyone with the topic name can read your alerts).
# Subscribe to the same topic in the ntfy iOS / Android app.
# Example: NTFY_TOPIC=trading-henry-7f3a92b81c4d
NTFY_TOPIC=

# Override only if you self-host ntfy. Leave blank for the public service.
NTFY_SERVER=

# Daemon runtime config (referenced by the VPS systemd unit's ExecStart).
# Change live via `tconfig TF [MIN_SCORE]` on the VPS — no need to edit by hand.
# Mac users running `make serve-bg` pass args positionally; these are ignored locally.
TRADING_TF=15m
TRADING_MIN_SCORE=3
