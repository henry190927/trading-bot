#!/bin/bash
# ops — operator commands for the trading services, run on the VPS over SSH.
#
# This is where service control lives now that /ops (the web page) no longer
# restarts units or streams raw logs: the web service should not hold host
# privileges, and SSH (Tailscale + key + passphrase) is the stronger door.
#
# The interface outlives the implementation. It wrapped systemd first; the
# services now run as containers (deploy/compose.yaml) and only the function
# bodies changed — `ops restart monitor` still means the same thing.
#
#   ops status                 deployed commit, web /health, monitor heartbeat
#   ops restart monitor|web    restart a container (asks for the sudo password)
#   ops logs monitor|web [-f] [N]
#                              last N log lines (default 50), -f to follow
#   ops zone [N]               last N zone-alert events (default 20)
set -euo pipefail

DATA="${TRADING_DATA:-/opt/trading}"
COMPOSE="$DATA/compose.yaml"
ENVF="$DATA/deploy.env"

# svc validates the name; the compose service is `monitor` / `web` and its
# journald tag (compose.yaml logging.options.tag) is `trading-<svc>`.
svc() {
    case "${1:-}" in
        monitor|web) echo "$1" ;;
        *) echo "unknown service '${1:-}' (monitor|web)" >&2; exit 2 ;;
    esac
}

cmd_status() {
    local tag bind
    tag="$(grep -E '^TAG=' "$ENVF" 2>/dev/null | cut -d= -f2-)"
    bind="$(grep -E '^WEB_BIND=' "$ENVF" 2>/dev/null | cut -d= -f2-)"
    printf '%-16s %s\n' "deployed" "${tag:0:12}${tag:+  https://github.com/henry190927/trading-bot/commit/$tag}"
    if [ -n "$bind" ] && curl -fsS --max-time 3 "http://$bind/health" >/dev/null 2>&1; then
        printf '%-16s %s\n' "trading-web" "/health 200"
    else
        printf '%-16s %s\n' "trading-web" "NOT answering /health on ${bind:-<no WEB_BIND>}"
    fi
    echo
    python3 - "$DATA/monitor-heartbeat.json" <<'EOF'
import json, re, sys, datetime
# Go writes nanoseconds; Python 3.10's fromisoformat takes at most six digits.
def ts(s): return datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", s))
try:
    b = json.load(open(sys.argv[1]))
except FileNotFoundError:
    print("heartbeat: no file"); sys.exit(0)
now = datetime.datetime.now(datetime.timezone.utc)
age = (now - ts(b["written_at"])).total_seconds()
print("heartbeat: %s, written %ds ago, pid %d" % ("ALIVE" if age <= 60 else "STALE", age, b["pid"]))
for n in sorted(b["loops"]):
    l = b["loops"][n]
    every = l.get("every_sec", 0)
    tick = (now - ts(l["last_tick"])).total_seconds() if l.get("last_tick") else None
    if not l["running"]:
        st = "off"
    elif every and tick is not None and tick > max(3 * every, 120):
        st = "STALLED"
    elif l.get("idle"):
        st = "idle"
    else:
        st = "run"
    t = "%5ds" % tick if tick is not None else "     -"
    print("  %-8s %-14s %s  %s" % (st, n, t, l.get("reason", "")))
EOF
}

cmd_restart() {
    local s
    s="$(svc "${1:-}")"
    sudo docker compose --env-file "$ENVF" -f "$COMPOSE" restart "$s"
    sudo docker compose --env-file "$ENVF" -f "$COMPOSE" ps "$s"
}

cmd_logs() {
    local s n=50 follow=()
    s="$(svc "${1:-}")"
    shift || true
    for a in "$@"; do
        case "$a" in
            -f) follow=(-f) ;;
            *[!0-9]*) echo "bad argument '$a'" >&2; exit 2 ;;
            *) n="$a" ;;
        esac
    done
    # journald logging driver: readable by the adm group, so no sudo needed.
    journalctl -t "trading-$s" -n "$n" --no-pager "${follow[@]}"
}

cmd_zone() {
    local n="${1:-20}"
    tail -n "$n" "$DATA/zone-events.jsonl" 2>/dev/null | python3 -c '
import json, sys
for line in sys.stdin:
    e = json.loads(line)
    print(e["at"][5:19].replace("T", " "), "", e["text"])
' || echo "no zone events"
}

case "${1:-}" in
    status) cmd_status ;;
    restart) cmd_restart "${2:-}" ;;
    logs) shift; cmd_logs "$@" ;;
    zone) cmd_zone "${2:-}" ;;
    *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
